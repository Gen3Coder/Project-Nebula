{
  "id_columns": [
    "event_id",
    "region",
    "window",
    "year",
    "trigger_date",
    "split"
  ],
  "numeric_features": [
    "rain_1d",
    "rain_3d",
    "rain_7d",
    "rain_14d",
    "rain_30d",
    "rain_antecedent_30d",
    "wet_days_7d",
    "wet_days_14d",
    "max_rain_3d",
    "intensity_7d",
    "dry_run_before",
    "max_dry_run_30d_before",
    "tmean_3d",
    "tmax_3d",
    "rh_3d",
    "wind_3d",
    "rad_3d",
    "vpd_3d",
    "vpd_7d",
    "et0_3d",
    "et0_7d",
    "sm_l1",
    "sm_l2",
    "sm_l3",
    "sm_l1_3dmean",
    "sm_l1_pre",
    "sm_l2_pre",
    "sm_l1_chg3",
    "sm_l2_chg3",
    "doy",
    "month",
    "elevation_mean",
    "slope_mean",
    "cropland_fraction",
    "clay_0_5cm_mean",
    "sand_0_5cm_mean",
    "soc_0_5cm_mean"
  ],
  "categorical_features": [
    "region",
    "window"
  ],
  "target": "false_start",
  "split_rule": "train: year <= 2015, test: later years",
  "label_rules": {
    "TRIGGER_MM": 20.0,
    "TRIGGER_DAYS": 3,
    "MIN_WET_DAYS_IN_TRIGGER": 2,
    "TRIGGER_WET_DAY_MM": 1.0,
    "FOLLOW_DAYS": 30,
    "DRY_SPELL_DAYS": 8,
    "DRY_DAY_MM": 1.0,
    "FIRST_TRIGGER_ONLY": true
  }
}
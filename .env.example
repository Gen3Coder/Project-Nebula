# Project Nebula Environment Variables

# Backend Server Configuration
PORT=5000

# PostgreSQL Database Configuration
DBUSER=postgres
DBPASSWORD=your_database_password
DBHOST=localhost
DBNAME=projectnebula
DBPORT=5432

# AfroMessage SMS API Credentials (https://afromessage.com)
AFRO_API_TOKEN=your_afromessage_api_token_here
AFRO_IDENTIFIER_ID=your_afromessage_identifier_id_here
AFRO_API_URL=https://api.afromessage.com/api/send

# External Climate & Environmental API (RainGuard Ethiopia)
API=https://project-nebula-3.onrender.com
